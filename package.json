{
  "name": "lumen-devops",
  "version": "1.0.0",
  "description": "LUMEN - tradutor de movimentações processuais para linguagem simples. Projeto N3 de Ferramentas de Implantação Contínua (DevOps).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "jest --selectProjects unit integration --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "selenium-webdriver": "^4.27.0",
    "supertest": "^7.0.0"
  }
}
